{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vLLM MI100 Bench Result (per cell)",
  "description": "Schema for one cell of the 24-cell baseline grid. Wraps `vllm bench serve --save-result` output and adds reproducibility metadata.",
  "type": "object",
  "required": [
    "model",
    "quant",
    "tp",
    "concurrency",
    "request_rate",
    "workload",
    "num_prompts",
    "mean_ttft_ms",
    "p50_ttft_ms",
    "p99_ttft_ms",
    "mean_tpot_ms",
    "p50_tpot_ms",
    "p99_tpot_ms",
    "output_throughput_toks_s",
    "request_throughput_req_s",
    "harness_commit",
    "vllm_commit",
    "rocm_version",
    "torch_version",
    "triton_version",
    "kernel_backend",
    "launch_command",
    "env",
    "timestamp"
  ],
  "properties": {
    "model": { "type": "string" },
    "quant": { "type": "string", "enum": ["w8a8-int8", "w4a16"] },
    "tp": { "type": "integer", "enum": [1, 4] },
    "concurrency": { "type": "integer", "enum": [1, 2, 4] },
    "request_rate": { "type": ["number", "string"] },
    "workload": { "type": "string", "enum": ["synthetic", "coding"] },
    "num_prompts": { "type": "integer", "minimum": 1 },
    "mean_ttft_ms": { "type": "number" },
    "p50_ttft_ms": { "type": "number" },
    "p99_ttft_ms": { "type": "number" },
    "mean_tpot_ms": { "type": "number" },
    "p50_tpot_ms": { "type": "number" },
    "p99_tpot_ms": { "type": "number" },
    "output_throughput_toks_s": { "type": "number", "minimum": 0 },
    "request_throughput_req_s": { "type": "number", "minimum": 0 },
    "harness_commit": { "type": "string", "minLength": 7 },
    "vllm_commit": { "type": "string", "minLength": 7 },
    "rocm_version": { "type": "string" },
    "torch_version": { "type": "string" },
    "triton_version": { "type": "string" },
    "tuning_json_sha256": { "type": ["string", "null"] },
    "kernel_backend": { "type": "string" },
    "launch_command": { "type": "string" },
    "env": { "type": "object" },
    "timestamp": { "type": "string" },
    "raw_vllm_bench": { "type": "object" }
  }
}
