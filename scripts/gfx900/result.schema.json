{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "provenance", "configuration", "workload", "trials", "aggregate", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {"type": "object", "required": ["cell_id", "phase", "started_at"]},
    "provenance": {"type": "object", "required": ["manifest_sha256", "platform_sha256"]},
    "configuration": {"type": "object", "required": ["resolved_digest", "launch_argv", "benchmark_argv", "environment"]},
    "workload": {"type": "string"},
    "trials": {"type": "array"},
    "aggregate": {"type": "object"},
    "verdict": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["PASS", "IMPROVEMENT", "REGRESSION", "INCOMPARABLE", "UNSUPPORTED", "FAILED"]}, "failure_reason": {"type": ["string", "null"]}}},
    "confirm": {"type": "object", "additionalProperties": false, "required": ["launch_count", "warmup_runs_per_launch", "recorded_runs_per_launch", "launches", "launch_medians", "reduction"], "properties": {"launch_count": {"const": 3}, "warmup_runs_per_launch": {"const": 1}, "recorded_runs_per_launch": {"const": 3}, "launches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["launch_index", "attempt", "started_at", "status", "failure_reason", "logs", "warmups", "trials", "aggregate"], "properties": {"launch_index": {"type": "integer", "minimum": 0}, "attempt": {"type": "integer", "minimum": 1}, "started_at": {"type": "string"}, "status": {"enum": ["PASS", "FAILED"]}, "failure_reason": {"type": ["string", "null"]}, "logs": {"type": "object", "additionalProperties": false, "required": ["stdout", "stderr"], "properties": {"stdout": {"type": "string"}, "stderr": {"type": "string"}}}, "warmups": {"type": "array"}, "trials": {"type": "array"}, "aggregate": {"type": "object"}}}}, "launch_medians": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["launch_index", "attempt", "aggregate"], "properties": {"launch_index": {"type": "integer", "minimum": 0}, "attempt": {"type": "integer", "minimum": 1}, "aggregate": {"type": "object"}}}}, "reduction": {"type": ["object", "null"]}}}
  }
}
